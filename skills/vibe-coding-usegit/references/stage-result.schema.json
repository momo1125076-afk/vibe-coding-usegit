{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UseGit stage result",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "status",
    "summary",
    "outputs",
    "evidence",
    "checks",
    "blockers",
    "executed_actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage": {
      "enum": [
        "discover",
        "find-skills",
        "find-repos",
        "evaluate",
        "run",
        "adapt",
        "deploy",
        "verify"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "failed",
        "skipped"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "claim",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "file",
              "command",
              "url",
              "manual"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "observed",
              "simulated",
              "not-run"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "file",
                    "command",
                    "manual"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "command"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "exit_code"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "command",
                    "manual",
                    "url"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "environment",
                "observed_at"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "url"
                }
              }
            },
            "then": {
              "required": [
                "url"
              ]
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "result",
          "evidence_ids"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not-run",
              "blocked",
              "not-applicable"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason",
          "next_action"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "target"
        ],
        "properties": {
          "action": {
            "enum": [
              "preview-deploy",
              "production-deploy",
              "store-submit",
              "paid-resource",
              "public-publish",
              "destructive"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "text",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "discover"
          },
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "required": [
          "requirements"
        ]
      }
    }
  ],
  "description": "Structural schema. The CLI additionally enforces file existence, dependency readiness, evidence hashes, authorization scope and acceptance coverage."
}
